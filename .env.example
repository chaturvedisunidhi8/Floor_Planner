# ---------------------------------------------------------------------------
# Floor Planner Agent - environment configuration
# Copy to `.env` and fill in the secrets. Every value below has a working
# default except the API keys, so the stack boots without any credentials.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database --------------------------------------------------------------
# PostgreSQL is the production target. When unset the app falls back to a local
# SQLite file so the project runs with zero infrastructure.
# DATABASE_URL=postgresql+psycopg://floorplanner:floorplanner@localhost:5432/floorplanner
DATABASE_URL=

# --- LLM (Groq) ------------------------------------------------------------
GROQ_API_KEY=groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=45

# --- Embeddings ------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
# Set to false to skip loading sentence-transformers (uses a deterministic
# hashing encoder instead - useful for CI and offline development).
EMBEDDINGS_ENABLED=true

# --- Vector store ----------------------------------------------------------
FAISS_INDEX_PATH=storage/index/templates.faiss
FAISS_METADATA_PATH=storage/index/templates_meta.json

# --- Image generation ------------------------------------------------------
# Strategy: hybrid | vector | flux
#   vector -> deterministic architectural renderer only (no credentials needed)
#   flux   -> FLUX.1-dev text-to-image only
#   hybrid -> geometry engine renders the plan, FLUX stylises it (recommended)
IMAGE_STRATEGY=hybrid
# Provider: huggingface | replicate | fal | local | none
IMAGE_PROVIDER=huggingface
FLUX_MODEL=black-forest-labs/FLUX.1-dev
HUGGINGFACE_API_KEY=
REPLICATE_API_TOKEN=
FAL_KEY=
IMAGE_TIMEOUT_SECONDS=180
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
# 0.0 keeps the geometry render untouched, 1.0 lets FLUX redraw everything.
FLUX_IMG2IMG_STRENGTH=0.35

# --- Generation tuning -----------------------------------------------------
TOP_K_TEMPLATES=5
VARIANTS_PER_REQUEST=4
STORAGE_DIR=storage/images
TEMPLATES_DIR=data/templates
REFERENCE_IMAGES_DIR=../Templates
